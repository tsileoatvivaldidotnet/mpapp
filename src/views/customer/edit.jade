extends ../layout
block append stylesheets
    link(rel='stylesheet', href='/stylesheets/customer/edit.css')

block append scripts 
    script(src='/javascripts/app/customer/edit.js', defer)

block content
    - var r = results || {}
    - var vehicles = r.vehicles || []
    div.edit-page-layout
        div.standard-form-container.edit-form
            +formheader("Customer Edit")
            form#frmEdit.edit-page-form-fields(method='POST' action='')
                input(type='hidden' name='id' value=customerId)
                div
                    div.edit-page-name-fields
                        label(for='txtFirstName') Name
                        div
                            input#txtFirstName(name='firstName' type='text' placeholder='First' value=r.firstName || '')
                            input#txtLastName(name='lastName' type='text' placeholder='Last' value=r.lastName || '')
                        label(for='txtAddress') Address
                        div
                            input#txtAddress(name='address1' type='text' placeholder='Street or PO Box' value=r.address1 || '')
                        label(for='txtCity') City/State/ZIP
                        div.edit-page-city-fields
                            input#txtCity(name='city' type='text' placeholder='City' value=r.city || '')
                            input#txtState(name='state' type='text' maxlength=2 placeholder='State' value=r.state || '')
                            input#txtZip(name='zip' type='text' maxlength=9 placeholder='ZIP' value=r.zip || '')
                div
                    div.edit-page-phone-fields
                        label(for='txtPhoneNumber') Phone
                        input#txtPhoneNumber(name='phone' type='text' value=r.phone || '')
                        label(for='txtEmailAddress') Email
                        input#txtEmailAddress(name='email' type='text' value=r.email || '')
        div.standard-form-container.vehicle-list
            +formheader("Vehicles")
            table
                thead
                    tr
                        th
                        th Year
                        th Make
                        th Model
                        th Trim
                        th Color
                        th VIN
                        th Cbx
                tbody
                    for vehicle in vehicles
                        tr(data-vehicle-id=vehicle.id)
                            td: input.function-input(type='text' maxlength=1 aria-label='Row action')
                            td.vehicle-year.clickable= vehicle.year
                            td= vehicle.make
                            td= vehicle.model
                            td= vehicle.trim
                            td= vehicle.color
                            td= vehicle.vin
                            td: div.vehicle-combo
        div.edit-functions
            button#btnEdit.edit-action(type='button')
                span.theme-classic-only E=
                | Edit
            button#btnDelete.edit-action(type='button')
                span.theme-classic-only D=
                | Delete
            button#btnAddVehicle.edit-action(type='button')
                span.theme-classic-only F3=
                | Add new vehicle
