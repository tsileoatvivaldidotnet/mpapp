extends ../layout
block append stylesheets
    link(rel='stylesheet', href='/stylesheets/customer/search.css')

block append scripts 
    script(src='/javascripts/app/customer/search.js', defer)

block content
    - var s = search || {}
    - var hasResults = (results != undefined && results != null)
    - if (results == undefined) results = []
    div#mainDiv
        div#modalForm.modal
            div.modal-contents
                button#btnCloseDelete.upper-right.x-to-close(type='button' aria-label='Close') X
                h2 Delete Customer
                p Are you sure you want to delete this customer?
                div.button-row
                    button#btnDeleteYes(type='button') Yes
                    button#btnDeleteNo(type='button') No
        div#searchForm.search-page-layout
            div.standard-form-container.search-form
                +formheader("Customer Search")
                form#frmSearch.search-page-form-fields(method='POST' action='')
                    label(for='txtPhoneNumber') Phone Number
                    input#txtPhoneNumber.search-input(name='phone' type='text' value=s.phone || '')
                    label(for='txtCity') City
                    input#txtCity.search-input(name='city' type='text' value=s.city || '')
                    label(for='txtLastName') Last Name
                    input#txtLastName.search-input(name='lastName' type='text' value=s.lastName || '')
                    label(for='txtFirstName') First Name
                    input#txtFirstName.search-input(name='firstName' type='text' value=s.firstName || '')
                    input#txtCustomerId(type='hidden' name='customerId')
                p#divSearchError.error.hidden.search-error At least one search field required
                form#frmEdit.hidden(method='GET')

            div.search-functions
                button#btnSearch.search-action(type='button')
                    span.theme-classic-only &lt;ENTER&gt; to 
                    | Search
                button#btnMenu.search-action(type='button')
                    span.theme-classic-only F2=
                    | Return to Menu
                button#btnNewCustomer.search-action(type='button')
                    span.theme-classic-only F5=
                    | New Customer

            div(class=hasResults ? 'standard-form-container search-results' : 'standard-form-container search-results hidden')
                +formheader("Results")
                table
                    thead
                        tr
                            th
                            th Name
                            th Address
                            th City State ZIP
                            th Phone
                    tbody
                        for result in results
                            tr(data-customer-id=result.id)
                                td: input.function-input(type='text' maxlength=1 aria-label='Row action')
                                td.customer-name.clickable= result.firstName + ' ' + result.lastName
                                td= result.address1
                                td= result.city + ' ' + result.state + ' ' + result.zip
                                td= result.phone
