include mixin.jade

doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title Moustache Pete
    block scripts
        script(src='/javascripts/jqx/jquery-3.7.1.min.js' defer)
        script(src='/javascripts/jqx/jqxcore.js' defer)
        script(src='/javascripts/jqx/jqx-all.js' defer)
        script(src='/javascripts/app/common.js' defer)
    block stylesheets
        link#theme-classic(rel='stylesheet' href='/stylesheets/mp-styles.css')
        link#theme-modern(rel='stylesheet' href='/stylesheets/mp-styles-modern.css' disabled)
        link(rel='stylesheet' href='/stylesheets/jqx/jqx.base.css')
        link(rel='stylesheet' href='/stylesheets/jqx/jqx.light.css')
    script.
      (function () {
        var theme = localStorage.getItem('mp-theme') || 'classic';
        var classic = document.getElementById('theme-classic');
        var modern = document.getElementById('theme-modern');
        if (classic) classic.disabled = theme === 'modern';
        if (modern) modern.disabled = theme !== 'modern';
        document.documentElement.setAttribute('data-theme', theme);
      })();
  body.page-background.screen-text
    nav.theme-switcher(aria-label='Appearance')
      span.theme-switcher-label Style
      div.theme-switcher-options(role='group' aria-label='Interface style')
        button(type='button' data-theme-option='classic' aria-pressed='true') Terminal
        button(type='button' data-theme-option='modern' aria-pressed='false') Modern
    block content
