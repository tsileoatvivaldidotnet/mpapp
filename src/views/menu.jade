extends ./layout
block append stylesheets
    link(rel='stylesheet', href='/stylesheets/main-menu.css')

block append scripts 
    script(src='/javascripts/app/menu.js', defer)

block content
    div.center-page-outer
        h1 Welcome to Moustache Pete
        ol.menu-list
            li.menu-item.clickable(data-menu-fn='1') Customer Search
            li.menu-item.clickable(data-menu-fn='2') Scheduling
            li.menu-item.clickable(data-menu-fn='9') Admin Menu
        div.menu-keyboard-hint
            span Select a function and hit &lt;enter&gt;
            input#txtFunction.function(type='text' maxlength=1)
            p#divFunctionError.error.hidden Invalid selection
